{
  "entities": {
    "generation": {
      "title": "Generation",
      "description": "Stored generation metadata and resulting content.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "productName": { "type": "string" },
        "topic": { "type": "string" },
        "platform": { "type": "string" },
        "tone": { "type": "string" },
        "cta": { "type": "string" },
        "imageUrl": { "type": "string" },
        "language": { "type": "string" },
        "generatedContent": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "productName", "topic", "platform", "tone", "cta", "generatedContent", "createdAt"]
    }
  },
  "firestore": {
    "generations/{generationId}": {
      "schema": "generation",
      "description": "Collection of content generations saved by users."
    }
  }
}
