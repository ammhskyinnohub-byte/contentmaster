rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net default catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation helper for generations
    function isValidGeneration(data) {
      return data.keys().hasAll(['id', 'userId', 'productName', 'topic', 'platform', 'tone', 'cta', 'generatedContent', 'createdAt'])
        && data.keys().size() <= 12 // Allow optional fields like language/imageUrl
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid
        && data.productName is string && data.productName.size() <= 300
        && data.topic is string && data.topic.size() <= 5000
        && data.platform is string && data.platform.size() <= 100
        && data.tone is string && data.tone.size() <= 100
        && data.cta is string && data.cta.size() <= 200
        && data.generatedContent is string && data.generatedContent.size() <= 50000
        && data.createdAt == request.time;
    }

    // Generations Collection matches
    match /generations/{generationId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || request.auth.token.email == "admin@fast.com");
      
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || request.auth.token.email == "admin@fast.com");
      
      allow create: if isSignedIn() 
        && isValidId(generationId) 
        && isValidGeneration(request.resource.data)
        && request.resource.data.id == generationId;
        
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || request.auth.token.email == "admin@fast.com");
    }

    // Users Collection matches
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || request.auth.token.email == "admin@fast.com");
      allow update: if isSignedIn() && (request.auth.uid == userId || request.auth.token.email == "admin@fast.com");
      allow list, create, delete: if isSignedIn() && request.auth.token.email == "admin@fast.com";
    }
  }
}
